{
  "name": "sprite-studio",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "npm run build && node studio/server.ts",
    "server": "node studio/server.ts",
    "build": "vite build",
    "dev": "vite",
    "protocol": "node probes/protocol.ts",
    "fixtures": "python probes/fixtures.py",
    "typecheck": "tsc --noEmit",
    "test": "node --test probes/*.test.ts studio/*.test.ts",
    "verify": "node probes/verify.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.7",
    "@fastify/static": "^10.1.8",
    "fastify": "^5.12.8",
    "lucide-react": "^1.67.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  }
}
